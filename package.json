    "db:reset": "prisma migrate reset",
    "build:check": "cross-env DEMO_MODE= next build",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
