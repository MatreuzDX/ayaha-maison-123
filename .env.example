# ─────────────────────────────────────────────────────────────
# AYAHA CRM — variáveis de ambiente
# Copiar para `.env` e preencher. O `.env` NUNCA vai para o Git.
# ─────────────────────────────────────────────────────────────

# BASE DE DADOS ──────────────────────────────────────────────
# Em Supabase: Project Settings → Database → Connection string.
# Usar a ligação DIRETA (porta 5432) — o pooler (6543) não suporta migrações.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres"

# Para desenvolvimento local com Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ayaha_crm?schema=public"

# APLICAÇÃO ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_UNIT_SLUG="benfica"

# ENCRIPTAÇÃO ────────────────────────────────────────────────
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Protege IBAN e segredos de MFA em repouso. Perder esta chave = perder esses dados.
ENCRYPTION_KEY=""

# CRON ───────────────────────────────────────────────────────
# Segredo partilhado que protege /api/cron/*. Gerar como acima.
CRON_SECRET=""

# ARMAZENAMENTO (Fase 7) ─────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ayaha-crm"

# MAPAS (Fase 3) ─────────────────────────────────────────────
# google | openroute | haversine
# `haversine` não precisa de chave e funciona offline, mas é só uma estimativa.
MAPS_PROVIDER="haversine"
GOOGLE_MAPS_API_KEY=""
OPENROUTE_API_KEY=""

# WHATSAPP (Fase 6) ──────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# E-MAIL (Fase 6) ────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="AYAHA MAISON <ola@ayahamaison.com>"

# SEED ───────────────────────────────────────────────────────
# Credenciais da conta inicial. TROCAR antes de qualquer uso real.
SEED_OWNER_EMAIL="ayaha@ayahamaison.com"
SEED_OWNER_PASSWORD=""
