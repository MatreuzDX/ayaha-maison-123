# ─────────────────────────────────────────────────────────────
# AYAHA CRM — variáveis de ambiente
# Copiar para `.env` e preencher. O `.env` NUNCA vai para o Git.
# ─────────────────────────────────────────────────────────────

# BASE DE DADOS ──────────────────────────────────────────────
# Produção: banco da própria Vercel (projeto → Storage → Neon). A Vercel
# define sozinha DATABASE_URL (pooler, usada pela app) e
# DATABASE_URL_UNPOOLED (direta, usada pelas migrações). Não copiar à mão.
#
# Desenvolvimento local: `npm run db:start` (Postgres embebido, porta 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ayaha_crm"

# APLICAÇÃO ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_UNIT_SLUG="benfica"

# ENCRIPTAÇÃO ────────────────────────────────────────────────
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Protege IBAN e segredos de MFA em repouso. Perder esta chave = perder esses dados.
ENCRYPTION_KEY=""

# CRON ───────────────────────────────────────────────────────
# Segredo partilhado que protege /api/cron/*. Gerar como acima.
CRON_SECRET=""

# ARMAZENAMENTO (Fase 7) ─────────────────────────────────────
# Nenhum código guarda ficheiros ainda. Quando as fotos das clientes
# precisarem de sítio, usar o Vercel Blob (projeto → Storage), para ficar
# tudo em GitHub + Vercel — decisão de 12/09/2026. As variáveis SUPABASE_*
# saíram: nunca foram usadas por código nenhum.

# MAPAS (Fase 3) ─────────────────────────────────────────────
# google | openroute | haversine
# `haversine` não precisa de chave e funciona offline, mas é só uma estimativa.
MAPS_PROVIDER="haversine"
GOOGLE_MAPS_API_KEY=""
OPENROUTE_API_KEY=""

# WHATSAPP (Fase 6) ──────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# E-MAIL (Fase 6) ────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="AYAHA MAISON <ola@ayahamaison.com>"

# SEED ───────────────────────────────────────────────────────
# Credenciais da conta inicial. TROCAR antes de qualquer uso real.
SEED_OWNER_EMAIL="ayaha@ayahamaison.com"
SEED_OWNER_PASSWORD=""

# LOGIN COM GOOGLE (portal de cliente) ──────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# URI de redirecionamento autorizado: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
