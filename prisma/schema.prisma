// AYAHA MAISON — CRM
// Schema completo. Ver docs/ESPECIFICACAO.md secção 6.
//
// Convenções:
//   - Dinheiro: Int em cêntimos, sufixo `Cents`
//   - Duração:  Int em minutos, sufixo `Min`
//   - Percentagem: Int em basis points (4000 = 40%), sufixo `Bps`
//   - Soft delete: `deletedAt DateTime?`
//   - Multi-tenant: `unitId` em todas as tabelas de negócio
//
// Nota: campos `*ById` (createdById, approvedById, uploadedById...) são scalars
// sem relação formal, para evitar dezenas de back-relations em User. A
// integridade é garantida na camada de serviço.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a connection string vive em prisma.config.ts, não aqui.
datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
// ORGANIZAÇÃO
// ═══════════════════════════════════════════════════════════

model Unit {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  timezone    String    @default("Europe/Lisbon")
  currency    String    @default("EUR")
  baseAddress String?
  baseLat     Float?
  baseLng     Float?
  isActive    Boolean   @default(true)
  settings    Json      @default("{}")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  users             UserUnit[]
  professionals     Professional[]
  clients           Client[]
  clientTags        ClientTag[]
  serviceCategories ServiceCategory[]
  services          Service[]
  appointments      Appointment[]
  timeOffs          TimeOff[]
  travelZones       TravelZone[]
  waitlistEntries   WaitlistEntry[]
  timelineEvents    TimelineEvent[]
  auditLogs         AuditLog[]
  messageTemplates  MessageTemplate[]
  messages          Message[]
  loyaltyProgram    LoyaltyProgram?
  rewardRedemptions RewardRedemption[]
  giftCards         GiftCard[]
  coupons           Coupon[]
  suppliers         Supplier[]
  materials         Material[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  invoices          Invoice[]
  payments          Payment[]
  cashSessions      CashSession[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  commissionRules   CommissionRule[]
  commissions       Commission[]
  payouts           Payout[]
  documents         Document[]
  documentTemplates DocumentTemplate[]
  consents          Consent[]
  dataRequests      DataRequest[]
  notifications     Notification[]
  settingEntries    Setting[]
  mappings          Mapping[]
  products          Product[]
  orders            Order[]

  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// UTILIZADORES, PAPÉIS E PERMISSÕES
// ═══════════════════════════════════════════════════════════

enum Role {
  OWNER
  MANAGER
  PROFESSIONAL
  RECEPTIONIST
  FINANCE
  READONLY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @db.Timestamptz(3)
  passwordHash  String?
  name          String
  phone         String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime? @db.Timestamptz(3)
  mfaSecret     String?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime? @db.Timestamptz(3)

  units         UserUnit[]
  professional  Professional?
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
}

model UserUnit {
  id        String   @id @default(cuid())
  userId    String
  unitId    String
  role      Role
  grants    String[] @default([])
  revokes   String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([unitId, role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  unitId       String?
  expires      DateTime @db.Timestamptz(3)
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ═══════════════════════════════════════════════════════════
// PROFISSIONAIS
// ═══════════════════════════════════════════════════════════

enum ContractType {
  OWNER
  EMPLOYEE
  FREELANCER
  RENT_CHAIR
}

model Professional {
  id                 String       @id @default(cuid())
  userId             String       @unique
  unitId             String
  displayName        String
  bio                String?
  color              String       @default("#C4A870")
  contractType       ContractType @default(FREELANCER)
  hireDate           DateTime?    @db.Timestamptz(3)
  terminationDate    DateTime?    @db.Timestamptz(3)
  taxId              String?
  ibanEncrypted      String?
  hasVehicle         Boolean      @default(false)
  transportMode      String       @default("DRIVING")
  maxTravelMin       Int          @default(45)
  homeLat            Float?
  homeLng            Float?
  monthlyTargetCents Int?
  isBookable         Boolean      @default(true)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?    @db.Timestamptz(3)

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit            Unit                @relation(fields: [unitId], references: [id])
  skills          ProfessionalSkill[]
  workingHours    WorkingHour[]
  timeOff         TimeOff[]
  appointments    Appointment[]
  commissionRules CommissionRule[]
  commissions     Commission[]
  payouts         Payout[]
  cashSessions    CashSession[]
  ownedClients    Client[]            @relation("ClientOwner")

  @@index([unitId, isBookable])
}

model ProfessionalSkill {
  id             String @id @default(cuid())
  professionalId String
  serviceId      String
  durationMin    Int?
  priceCents     Int?
  proficiency    Int    @default(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

// ═══════════════════════════════════════════════════════════
// HORÁRIOS E AUSÊNCIAS
// ═══════════════════════════════════════════════════════════

model WorkingHour {
  id             String    @id @default(cuid())
  professionalId String
  weekday        Int
  startMin       Int
  endMin         Int
  validFrom      DateTime  @default(now()) @db.Timestamptz(3)
  validUntil     DateTime? @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  TRAINING
  BLOCKED
  HOLIDAY
}

model TimeOff {
  id             String      @id @default(cuid())
  professionalId String?
  unitId         String
  type           TimeOffType
  startAt        DateTime    @db.Timestamptz(3)
  endAt          DateTime    @db.Timestamptz(3)
  allDay         Boolean     @default(false)
  reason         String?
  approvedById   String?
  approvedAt     DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  unit         Unit          @relation(fields: [unitId], references: [id])

  @@index([unitId, startAt, endAt])
}

// ═══════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════

enum ClientStatus {
  LEAD
  ACTIVE
  AT_RISK
  DORMANT
  BLOCKED
}

enum AcquisitionSource {
  INSTAGRAM
  WHATSAPP
  REFERRAL
  GOOGLE
  WALK_BY
  WEBSITE
  OTHER
}

model Client {
  id                  String             @id @default(cuid())
  unitId              String
  firstName           String
  lastName            String?
  email               String?
  phone               String
  phoneWhatsapp       Boolean            @default(true)
  birthDate           DateTime?          @db.Timestamptz(3)
  taxId               String?
  instagram           String?
  profession          String?
  photoUrl            String?
  /// Favorita e VIP são coisas diferentes: favorita é atalho pessoal de quem
  /// usa o sistema; VIP é estatuto do negócio e afeta prioridade e campanhas.
  isFavorite          Boolean            @default(false)
  isVip               Boolean            @default(false)
  addressLine         String?
  addressExtra        String?
  postalCode          String?
  city                String?            @default("Lisboa")
  parish              String?
  lat                 Float?
  lng                 Float?
  geocodedAt          DateTime?          @db.Timestamptz(3)
  travelZoneId        String?
  accessNotes         String?
  parkingNotes        String?
  status              ClientStatus       @default(LEAD)
  source              AcquisitionSource?
  referredById        String?
  ownerProfessionalId String?
  firstVisitAt        DateTime?          @db.Timestamptz(3)
  lastVisitAt         DateTime?          @db.Timestamptz(3)
  nextVisitAt         DateTime?          @db.Timestamptz(3)
  visitCount          Int                @default(0)
  noShowCount         Int                @default(0)
  cancelCount         Int                @default(0)
  lifetimeValueCents  Int                @default(0)
  avgTicketCents      Int                @default(0)
  avgIntervalDays     Int?
  marketingOptIn      Boolean            @default(false)
  marketingOptInAt    DateTime?          @db.Timestamptz(3)
  preferredChannel    String             @default("WHATSAPP")
  language            String             @default("pt-PT")
  notes               String?
  customFields        Json               @default("{}")
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?          @db.Timestamptz(3)

  unit              Unit                @relation(fields: [unitId], references: [id])
  travelZone        TravelZone?         @relation(fields: [travelZoneId], references: [id])
  ownerProfessional Professional?       @relation("ClientOwner", fields: [ownerProfessionalId], references: [id])
  referredBy        Client?             @relation("Referrals", fields: [referredById], references: [id])
  referrals         Client[]            @relation("Referrals")
  addresses         ClientAddress[]
  tags              ClientTagLink[]
  healthRecord      ClientHealthRecord?
  lashProfile       LashProfile?
  mappings          Mapping[]
  appointments      Appointment[]
  timeline          TimelineEvent[]
  consents          Consent[]
  documents         Document[]
  loyaltyCards      LoyaltyCard[]
  rewardRedemptions RewardRedemption[]
  giftCardsOwned    GiftCard[]          @relation("GiftCardOwner")
  couponRedemptions CouponRedemption[]
  invoices          Invoice[]
  payments          Payment[]
  waitlistEntries   WaitlistEntry[]
  messages          Message[]
  dataRequests      DataRequest[]
  account           ClientAccount?
  orders            Order[]

  @@index([unitId, status])
  @@index([unitId, lastVisitAt])
  @@index([unitId, nextVisitAt])
  @@index([phone])
}

model ClientAddress {
  id           String   @id @default(cuid())
  clientId     String
  label        String
  addressLine  String
  addressExtra String?
  postalCode   String?
  city         String   @default("Lisboa")
  lat          Float?
  lng          Float?
  travelZoneId String?
  accessNotes  String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  travelZone   TravelZone?   @relation(fields: [travelZoneId], references: [id])
  appointments Appointment[]

  @@index([clientId])
}

/// Dados de saúde — CATEGORIA ESPECIAL RGPD (art. 9.º). Acesso restrito e auditado.
model ClientHealthRecord {
  id                String    @id @default(cuid())
  clientId          String    @unique
  allergies         String?
  medications       String?
  eyeConditions     String?
  contactLenses     Boolean   @default(false)
  previousReactions String?
  pregnant          Boolean?
  skinSensitivity   String?
  glueSensitivity   Boolean?
  patchTestAt       DateTime? @db.Timestamptz(3)
  patchTestResult   String?
  lastReviewedAt    DateTime? @db.Timestamptz(3)
  lastReviewedById  String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientTag {
  id     String @id @default(cuid())
  unitId String
  name   String
  color  String @default("#C4A870")

  unit    Unit            @relation(fields: [unitId], references: [id])
  clients ClientTagLink[]

  @@unique([unitId, name])
}

model ClientTagLink {
  clientId  String
  tagId     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  client Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

// ═══════════════════════════════════════════════════════════
// CATÁLOGO DE SERVIÇOS
// ═══════════════════════════════════════════════════════════

model ServiceCategory {
  id        String  @id @default(cuid())
  unitId    String
  name      String
  slug      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  unit     Unit      @relation(fields: [unitId], references: [id])
  services Service[]

  @@unique([unitId, slug])
}

model Service {
  id                 String  @id @default(cuid())
  unitId             String
  categoryId         String
  name               String
  slug               String
  description        String?
  tagline            String?
  durationMin        Int
  setupMin           Int     @default(15)
  teardownMin        Int     @default(5)
  bufferAfterMin     Int     @default(0)
  priceCents         Int
  priceOnRequest     Boolean @default(false)
  costCents          Int     @default(0)
  vatBps             Int     @default(0)
  requiresPatchTest  Boolean @default(false)
  minAdvanceHours    Int     @default(12)
  maxAdvanceDays     Int     @default(90)
  requiresDeposit    Boolean @default(false)
  depositCents       Int     @default(0)
  isMaintenance      Boolean @default(false)
  parentServiceId    String?
  recommendedGapDays Int?
  commissionBps      Int?
  isActive           Boolean @default(true)
  sortOrder          Int     @default(0)

  // ── Catálogo público ──
  // Nada disto existe para o funcionamento interno (agenda, comissões,
  // stock) — é só o que o site público mostra a quem ainda não é cliente.
  // Fica opcional de propósito: um serviço pode existir e ser marcado sem
  // ter ainda uma ficha pronta para publicar.
  imageUrl        String?
  highlights      String[] @default([])
  longDescription String[] @default([])
  /// Rótulo cosmético do cartão público (Clássico, Volume, Efeitos...).
  /// Independente de `categoryId`, que organiza a agenda internamente.
  displayCategory String?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  unit             Unit                @relation(fields: [unitId], references: [id])
  category         ServiceCategory     @relation(fields: [categoryId], references: [id])
  parentService    Service?            @relation("ServiceMaintenance", fields: [parentServiceId], references: [id])
  maintenanceOf    Service[]           @relation("ServiceMaintenance")
  skills           ProfessionalSkill[]
  materials        ServiceMaterial[]
  appointmentItems AppointmentItem[]

  @@unique([unitId, slug])
  @@index([unitId, isActive])
}

/// Bill of materials — consumo padrão de material por serviço
model ServiceMaterial {
  id         String @id @default(cuid())
  serviceId  String
  materialId String
  quantity   Float

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([serviceId, materialId])
}

// ═══════════════════════════════════════════════════════════
// AGENDA / ATENDIMENTOS
// ═══════════════════════════════════════════════════════════

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  REMINDED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum CancelledBy {
  CLIENT
  PROFESSIONAL
  SYSTEM
}

model Appointment {
  id                String            @id @default(cuid())
  unitId            String
  code              String            @unique
  clientId          String
  professionalId    String
  status            AppointmentStatus @default(REQUESTED)
  startAt           DateTime          @db.Timestamptz(3)
  endAt             DateTime          @db.Timestamptz(3)
  /// startAt menos o tempo de deslocação. NUNCA nulo — é a base da constraint
  /// de exclusão que impede marcações geograficamente impossíveis.
  departAt          DateTime          @db.Timestamptz(3)
  travelToMin       Int               @default(0)
  travelFromMin     Int               @default(0)
  addressId         String?
  addressSnapshot   Json?
  travelFeeCents    Int               @default(0)
  travelDistanceM   Int?
  subtotalCents     Int               @default(0)
  discountCents     Int               @default(0)
  totalCents        Int               @default(0)
  depositCents      Int               @default(0)
  depositPaidAt     DateTime?         @db.Timestamptz(3)
  source            String            @default("MANUAL")
  createdById       String?
  cancelledAt       DateTime?         @db.Timestamptz(3)
  cancelledBy       CancelledBy?
  cancelReason      String?
  rescheduledFromId String?           @unique
  checkedInAt       DateTime?         @db.Timestamptz(3)
  startedAt         DateTime?         @db.Timestamptz(3)
  completedAt       DateTime?         @db.Timestamptz(3)
  internalNotes     String?
  clientNotes       String?
  followUpSentAt    DateTime?         @db.Timestamptz(3)
  ratingStars       Int?
  ratingComment     String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?         @db.Timestamptz(3)

  unit            Unit                      @relation(fields: [unitId], references: [id])
  client          Client                    @relation(fields: [clientId], references: [id])
  professional    Professional              @relation(fields: [professionalId], references: [id])
  address         ClientAddress?            @relation(fields: [addressId], references: [id])
  rescheduledFrom Appointment?              @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment?              @relation("Reschedule")
  items           AppointmentItem[]
  statusHistory   AppointmentStatusChange[]
  photos          AppointmentPhoto[]
  stockMovements  StockMovement[]
  commissions     Commission[]
  loyaltyStamp    LoyaltyStamp?
  mapping         Mapping?
  invoice         Invoice?
  payments        Payment[]

  @@index([unitId, startAt])
  @@index([professionalId, startAt])
  @@index([clientId, startAt])
  @@index([unitId, status, startAt])
}

model AppointmentItem {
  id             String @id @default(cuid())
  appointmentId  String
  serviceId      String
  nameSnapshot   String
  durationMin    Int
  unitPriceCents Int
  quantity       Int    @default(1)
  discountCents  Int    @default(0)
  totalCents     Int
  commissionBps  Int?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
}

model AppointmentStatusChange {
  id            String             @id @default(cuid())
  appointmentId String
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  changedById   String?
  reason        String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model AppointmentPhoto {
  id            String   @id @default(cuid())
  appointmentId String
  kind          String
  storagePath   String
  consentGiven  Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

// ═══════════════════════════════════════════════════════════
// DESLOCAÇÃO
// ═══════════════════════════════════════════════════════════

model TravelZone {
  id             String   @id @default(cuid())
  unitId         String
  name           String
  description    String?
  feeCents       Int      @default(0)
  freeAboveCents Int?
  minSpendCents  Int      @default(0)
  estimatedMin   Int
  maxRadiusKm    Float?
  postalPrefixes String[] @default([])
  color          String   @default("#C4A870")
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)

  unit      Unit            @relation(fields: [unitId], references: [id])
  clients   Client[]
  addresses ClientAddress[]

  @@unique([unitId, name])
}

/// Cache de estimativas da API de mapas. Chave por geohash para agrupar
/// moradas próximas e poupar chamadas pagas.
model TravelEstimate {
  id          String   @id @default(cuid())
  originHash  String
  destHash    String
  mode        String
  timeBand    String
  durationMin Int
  distanceM   Int
  provider    String
  fetchedAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([originHash, destHash, mode, timeBand])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════
// LISTA DE ESPERA
// ═══════════════════════════════════════════════════════════

enum WaitlistStatus {
  WAITING
  OFFERED
  ACCEPTED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id                String         @id @default(cuid())
  unitId            String
  clientId          String
  serviceIds        String[]
  professionalId    String?
  earliestDate      DateTime       @db.Timestamptz(3)
  latestDate        DateTime       @db.Timestamptz(3)
  weekdays          Int[]          @default([])
  preferredStartMin Int?
  preferredEndMin   Int?
  priority          Int            @default(0)
  status            WaitlistStatus @default(WAITING)
  offeredSlotAt     DateTime?      @db.Timestamptz(3)
  offerExpiresAt    DateTime?      @db.Timestamptz(3)
  offerCount        Int            @default(0)
  notes             String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  unit   Unit   @relation(fields: [unitId], references: [id])
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([unitId, status, earliestDate])
}

// ═══════════════════════════════════════════════════════════
// TIMELINE E AUDITORIA
// ═══════════════════════════════════════════════════════════

model TimelineEvent {
  id         String   @id @default(cuid())
  unitId     String
  clientId   String?
  entityType String
  entityId   String
  type       String
  title      String
  body       String?
  icon       String?
  actorId    String?
  actorName  String?
  isPinned   Boolean  @default(false)
  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  unit   Unit    @relation(fields: [unitId], references: [id])
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, occurredAt])
  @@index([unitId, entityType, entityId])
}

/// Append-only. UPDATE e DELETE revogados por migração SQL.
model AuditLog {
  id         String   @id @default(cuid())
  unitId     String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  unit Unit? @relation(fields: [unitId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([unitId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// COMUNICAÇÕES
// ═══════════════════════════════════════════════════════════

enum MessageChannel {
  WHATSAPP
  EMAIL
  SMS
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model MessageTemplate {
  id          String         @id @default(cuid())
  unitId      String
  key         String
  channel     MessageChannel
  name        String
  subject     String?
  body        String
  providerRef String?
  variables   String[]       @default([])
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, key, channel])
}

model Message {
  id            String           @id @default(cuid())
  unitId        String
  clientId      String?
  appointmentId String?
  channel       MessageChannel
  direction     MessageDirection
  status        MessageStatus    @default(QUEUED)
  templateKey   String?
  toAddress     String
  subject       String?
  body          String
  providerId    String?
  errorMessage  String?
  scheduledFor  DateTime?        @db.Timestamptz(3)
  sentAt        DateTime?        @db.Timestamptz(3)
  deliveredAt   DateTime?        @db.Timestamptz(3)
  readAt        DateTime?        @db.Timestamptz(3)
  costCents     Int              @default(0)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  unit   Unit    @relation(fields: [unitId], references: [id])
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([unitId, createdAt])
  @@index([clientId, createdAt])
  @@index([status, scheduledFor])
}

// ═══════════════════════════════════════════════════════════
// AYAHA CLUB — CARTÃO DE CARIMBOS
// (NÃO é sistema de pontos. Ver spec 18.1.)
// ═══════════════════════════════════════════════════════════

model LoyaltyProgram {
  id              String   @id @default(cuid())
  unitId          String   @unique
  name            String   @default("AYAHA Club")
  isActive        Boolean  @default(true)
  stampsRequired  Int      @default(5)
  autoRestart     Boolean  @default(true)
  rewardValidDays Int      @default(180)
  termsText       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  unit    Unit          @relation(fields: [unitId], references: [id])
  cards   LoyaltyCard[]
  rewards Reward[]
}

/// Um cartão por ciclo. Cliente com 12 atendimentos tem 2 cartões completos
/// e 1 em curso com 2 carimbos.
model LoyaltyCard {
  id             String    @id @default(cuid())
  programId      String
  clientId       String
  cycleNumber    Int       @default(1)
  stampsCount    Int       @default(0)
  stampsRequired Int
  completedAt    DateTime? @db.Timestamptz(3)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  program    LoyaltyProgram    @relation(fields: [programId], references: [id])
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stamps     LoyaltyStamp[]
  redemption RewardRedemption?

  @@unique([clientId, cycleNumber])
  @@index([clientId, isActive])
}

model LoyaltyStamp {
  id            String    @id @default(cuid())
  cardId        String
  appointmentId String?   @unique
  reason        String    @default("APPOINTMENT")
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  revokedReason String?

  card        LoyaltyCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
}

enum RewardKind {
  DISCOUNT_FIXED
  SERVICE_UPGRADE
  GIFT_CARD
  FREE_SERVICE
}

model Reward {
  id            String     @id @default(cuid())
  programId     String
  name          String
  description   String?
  kind          RewardKind
  valueCents    Int        @default(0)
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  redeemedCount Int        @default(0)

  program     LoyaltyProgram     @relation(fields: [programId], references: [id])
  redemptions RewardRedemption[]
}

enum RedemptionStatus {
  AVAILABLE
  USED
  EXPIRED
  CANCELLED
}

model RewardRedemption {
  id                String           @id @default(cuid())
  unitId            String
  cardId            String           @unique
  rewardId          String
  clientId          String
  code              String           @unique
  status            RedemptionStatus @default(AVAILABLE)
  chosenAt          DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime?        @db.Timestamptz(3)
  usedAt            DateTime?        @db.Timestamptz(3)
  usedAppointmentId String?
  giftCardId        String?          @unique
  note              String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  unit     Unit        @relation(fields: [unitId], references: [id])
  card     LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reward   Reward      @relation(fields: [rewardId], references: [id])
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  giftCard GiftCard?   @relation(fields: [giftCardId], references: [id])

  @@index([clientId, status])
  @@index([unitId, status])
}

// ═══════════════════════════════════════════════════════════
// GIFT CARDS E CUPÕES
// ═══════════════════════════════════════════════════════════

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCard {
  id             String         @id @default(cuid())
  unitId         String
  code           String         @unique
  initialCents   Int
  balanceCents   Int
  status         GiftCardStatus @default(ACTIVE)
  purchaserName  String?
  purchaserEmail String?
  recipientName  String?
  recipientEmail String?
  ownerClientId  String?
  message        String?
  designUrl      String?
  issuedAt       DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime?      @db.Timestamptz(3)
  soldById       String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  unit         Unit                  @relation(fields: [unitId], references: [id])
  owner        Client?               @relation("GiftCardOwner", fields: [ownerClientId], references: [id])
  transactions GiftCardTransaction[]
  payments     Payment[]
  redemption   RewardRedemption?

  @@index([unitId, status])
}

model GiftCardTransaction {
  id          String   @id @default(cuid())
  giftCardId  String
  amountCents Int
  invoiceId   String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt])
}

enum CouponKind {
  PERCENT
  FIXED
  FREE_SERVICE
}

model Coupon {
  id                   String     @id @default(cuid())
  unitId               String
  code                 String
  name                 String
  kind                 CouponKind
  valueBps             Int?
  valueCents           Int?
  serviceId            String?
  minSubtotalCents     Int        @default(0)
  maxDiscountCents     Int?
  validFrom            DateTime   @default(now()) @db.Timestamptz(3)
  validUntil           DateTime?  @db.Timestamptz(3)
  usageLimit           Int?
  perClientLimit       Int        @default(1)
  usedCount            Int        @default(0)
  firstVisitOnly       Boolean    @default(false)
  applicableServiceIds String[]   @default([])
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  unit        Unit               @relation(fields: [unitId], references: [id])
  redemptions CouponRedemption[]
  orders      Order[]

  @@unique([unitId, code])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  clientId      String
  appointmentId String?
  invoiceId     String?
  amountCents   Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([couponId, clientId])
}

// ═══════════════════════════════════════════════════════════
// STOCK DE MATERIAIS
// ═══════════════════════════════════════════════════════════

model Supplier {
  id       String  @id @default(cuid())
  unitId   String
  name     String
  email    String?
  phone    String?
  website  String?
  notes    String?
  isActive Boolean @default(true)

  unit      Unit            @relation(fields: [unitId], references: [id])
  materials Material[]
  orders    PurchaseOrder[]
}

model Material {
  id              String    @id @default(cuid())
  unitId          String
  supplierId      String?
  sku             String?
  name            String
  brand           String?
  category        String?
  unit_           String    @default("un") @map("unit")
  quantityOnHand  Float     @default(0)
  minQuantity     Float     @default(0)
  reorderQuantity Float     @default(0)
  costCents       Int       @default(0)
  lastCostCents   Int       @default(0)
  tracksExpiry    Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  unitRel      Unit                @relation(fields: [unitId], references: [id])
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  movements    StockMovement[]
  serviceUsage ServiceMaterial[]
  batches      MaterialBatch[]
  orderItems   PurchaseOrderItem[]

  @@index([unitId, isActive])
}

model MaterialBatch {
  id         String    @id @default(cuid())
  materialId String
  batchCode  String?
  quantity   Float
  expiresAt  DateTime? @db.Timestamptz(3)
  receivedAt DateTime  @default(now()) @db.Timestamptz(3)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, expiresAt])
}

enum StockMovementKind {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  LOSS
  RETURN
  TRANSFER
}

model StockMovement {
  id              String            @id @default(cuid())
  unitId          String
  materialId      String
  kind            StockMovementKind
  quantity        Float
  costCents       Int               @default(0)
  appointmentId   String?
  professionalId  String?
  purchaseOrderId String?
  note            String?
  createdById     String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  unit        Unit         @relation(fields: [unitId], references: [id])
  material    Material     @relation(fields: [materialId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([unitId, createdAt])
  @@index([materialId, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  unitId     String
  supplierId String
  reference  String?
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime?           @db.Timestamptz(3)
  receivedAt DateTime?           @db.Timestamptz(3)
  totalCents Int                 @default(0)
  notes      String?
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  unit     Unit                @relation(fields: [unitId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  materialId      String
  quantity        Float
  unitCostCents   Int
  totalCents      Int

  order    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id])
}

// ═══════════════════════════════════════════════════════════
// FINANCEIRO
// ═══════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MBWAY
  TRANSFER
  GIFT_CARD
  OTHER
}

model Invoice {
  id                  String        @id @default(cuid())
  unitId              String
  number              String
  clientId            String
  appointmentId       String?       @unique
  status              InvoiceStatus @default(DRAFT)
  issuedAt            DateTime?     @db.Timestamptz(3)
  dueAt               DateTime?     @db.Timestamptz(3)
  subtotalCents       Int           @default(0)
  discountCents       Int           @default(0)
  travelFeeCents      Int           @default(0)
  vatCents            Int           @default(0)
  totalCents          Int           @default(0)
  paidCents           Int           @default(0)
  clientNameSnapshot  String
  clientTaxIdSnapshot String?
  externalRef         String?
  notes               String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  unit        Unit          @relation(fields: [unitId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]

  @@unique([unitId, number])
  @@index([unitId, issuedAt])
  @@index([clientId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  discountCents  Int     @default(0)
  vatBps         Int     @default(0)
  totalCents     Int
  serviceId      String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  unitId        String
  invoiceId     String?
  appointmentId String?
  clientId      String?
  /// Liga o pagamento a uma encomenda da loja. Fica solto do Invoice de
  /// propósito: o financeiro está pausado à espera de decisões sobre IVA, e
  /// a loja não devia ficar refém dessa decisão para poder lançar.
  orderId       String?
  method        PaymentMethod
  amountCents   Int
  reference     String?
  giftCardId    String?
  receivedAt    DateTime      @default(now()) @db.Timestamptz(3)
  receivedById  String?
  cashSessionId String?
  isRefund      Boolean       @default(false)
  note          String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  unit        Unit         @relation(fields: [unitId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])
  giftCard    GiftCard?    @relation(fields: [giftCardId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])

  @@index([unitId, receivedAt])
}

model CashSession {
  id                String    @id @default(cuid())
  unitId            String
  professionalId    String?
  openedAt          DateTime  @default(now()) @db.Timestamptz(3)
  closedAt          DateTime? @db.Timestamptz(3)
  openingCents      Int       @default(0)
  expectedCashCents Int       @default(0)
  countedCashCents  Int?
  differenceCents   Int?
  notes             String?
  openedById        String
  closedById        String?

  unit         Unit           @relation(fields: [unitId], references: [id])
  professional Professional?  @relation(fields: [professionalId], references: [id])
  payments     Payment[]
  movements    CashMovement[]

  @@index([unitId, openedAt])
}

model CashMovement {
  id            String   @id @default(cuid())
  cashSessionId String
  kind          String
  amountCents   Int
  reason        String
  createdById   String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  session CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id      String  @id @default(cuid())
  unitId  String
  name    String
  isFixed Boolean @default(false)

  unit     Unit      @relation(fields: [unitId], references: [id])
  expenses Expense[]

  @@unique([unitId, name])
}

model Expense {
  id             String         @id @default(cuid())
  unitId         String
  categoryId     String
  description    String
  amountCents    Int
  vatCents       Int            @default(0)
  incurredAt     DateTime       @db.Timestamptz(3)
  paidAt         DateTime?      @db.Timestamptz(3)
  method         PaymentMethod?
  supplierId     String?
  professionalId String?
  receiptPath    String?
  isRecurring    Boolean        @default(false)
  recurrenceRule String?
  createdById    String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  unit     Unit            @relation(fields: [unitId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([unitId, incurredAt])
}

// ═══════════════════════════════════════════════════════════
// COMISSÕES
// ═══════════════════════════════════════════════════════════

enum CommissionBasis {
  SERVICE_REVENUE
  NET_REVENUE
  FIXED_PER_SERVICE
}

model CommissionRule {
  id              String          @id @default(cuid())
  unitId          String
  professionalId  String?
  serviceId       String?
  categoryId      String?
  basis           CommissionBasis @default(SERVICE_REVENUE)
  rateBps         Int             @default(4000)
  fixedCents      Int             @default(0)
  tierFromCents   Int             @default(0)
  tierToCents     Int?
  deductMaterials Boolean         @default(false)
  deductTravel    Boolean         @default(true)
  priority        Int             @default(0)
  validFrom       DateTime        @default(now()) @db.Timestamptz(3)
  validUntil      DateTime?       @db.Timestamptz(3)
  isActive        Boolean         @default(true)

  unit         Unit          @relation(fields: [unitId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  commissions  Commission[]

  @@index([unitId, professionalId, isActive])
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model Commission {
  id             String           @id @default(cuid())
  unitId         String
  professionalId String
  appointmentId  String?
  invoiceId      String?
  ruleId         String?
  baseCents      Int
  rateBps        Int
  amountCents    Int
  status         CommissionStatus @default(PENDING)
  periodMonth    Int
  periodYear     Int
  payoutId       String?
  note           String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  unit         Unit            @relation(fields: [unitId], references: [id])
  professional Professional    @relation(fields: [professionalId], references: [id])
  appointment  Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rule         CommissionRule? @relation(fields: [ruleId], references: [id])
  payout       Payout?         @relation(fields: [payoutId], references: [id])

  @@index([unitId, periodYear, periodMonth])
  @@index([professionalId, status])
}

model Payout {
  id              String         @id @default(cuid())
  unitId          String
  professionalId  String
  periodMonth     Int
  periodYear      Int
  commissionCents Int            @default(0)
  bonusCents      Int            @default(0)
  deductionCents  Int            @default(0)
  totalCents      Int            @default(0)
  status          String         @default("DRAFT")
  paidAt          DateTime?      @db.Timestamptz(3)
  method          PaymentMethod?
  reference       String?
  documentPath    String?
  approvedById    String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  unit         Unit         @relation(fields: [unitId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  commissions  Commission[]

  @@unique([unitId, professionalId, periodYear, periodMonth])
}

// ═══════════════════════════════════════════════════════════
// DOCUMENTOS, ASSINATURA E RGPD
// ═══════════════════════════════════════════════════════════

enum DocumentKind {
  CONSENT_FORM
  ANAMNESIS
  CONTRACT
  ID_DOCUMENT
  INVOICE_PDF
  PHOTO
  CERTIFICATE
  OTHER
}

model Document {
  id             String       @id @default(cuid())
  unitId         String
  clientId       String?
  professionalId String?
  kind           DocumentKind
  title          String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  checksum       String?
  isSensitive    Boolean      @default(false)
  expiresAt      DateTime?    @db.Timestamptz(3)
  uploadedById   String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3)

  unit       Unit        @relation(fields: [unitId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  signatures Signature[]
  consents   Consent[]

  @@index([unitId, clientId])
}

model DocumentTemplate {
  id                String       @id @default(cuid())
  unitId            String
  kind              DocumentKind
  name              String
  bodyHtml          String
  requiresSignature Boolean      @default(true)
  version           Int          @default(1)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])
}

model Signature {
  id           String   @id @default(cuid())
  documentId   String
  signerName   String
  signerRole   String
  clientId     String?
  imagePath    String
  signedAt     DateTime @default(now()) @db.Timestamptz(3)
  ip           String?
  userAgent    String?
  documentHash String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

enum ConsentPurpose {
  SERVICE_DELIVERY
  HEALTH_DATA
  MARKETING_EMAIL
  MARKETING_WHATSAPP
  PHOTOS_INTERNAL
  PHOTOS_PUBLIC
  DATA_RETENTION
}

model Consent {
  id           String         @id @default(cuid())
  unitId       String
  clientId     String
  purpose      ConsentPurpose
  granted      Boolean
  version      String
  textSnapshot String
  method       String
  documentId   String?
  ip           String?
  grantedAt    DateTime?      @db.Timestamptz(3)
  revokedAt    DateTime?      @db.Timestamptz(3)
  expiresAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  unit     Unit      @relation(fields: [unitId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id])

  @@index([clientId, purpose])
}

/// Pedidos de titular de dados (RGPD art. 15.º-22.º)
model DataRequest {
  id             String    @id @default(cuid())
  unitId         String
  clientId       String?
  requesterEmail String
  kind           String
  status         String    @default("RECEIVED")
  notes          String?
  resultPath     String?
  dueAt          DateTime  @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  handledById    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  unit   Unit    @relation(fields: [unitId], references: [id])
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([unitId, status, dueAt])
}

// ═══════════════════════════════════════════════════════════
// JOBS, NOTIFICAÇÕES E DEFINIÇÕES
// ═══════════════════════════════════════════════════════════

model JobQueue {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  runAt       DateTime  @db.Timestamptz(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  status      String    @default("PENDING")
  lastError   String?
  lockedAt    DateTime? @db.Timestamptz(3)
  lockedBy    String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([status, runAt])
}

model Notification {
  id        String    @id @default(cuid())
  unitId    String
  userId    String
  kind      String
  title     String
  body      String?
  link      String?
  severity  String    @default("INFO")
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Setting {
  id        String   @id @default(cuid())
  unitId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, key])
}

// ═══════════════════════════════════════════════════════════
// FICHA TÉCNICA DE PESTANAS
// ═══════════════════════════════════════════════════════════
//
// Nota importante sobre alergias: NÃO vivem aqui. Estão em
// `ClientHealthRecord`, que já as guarda com o tratamento de categoria
// especial que o RGPD exige. Duplicá-las criaria duas fontes de verdade para
// informação que pode causar uma reação alérgica — o pior sítio possível para
// haver ambiguidade.

/// Curvaturas do mercado, da mais reta à mais curvada.
enum LashCurl {
  I
  B
  C
  CC
  D
  DD
  L
  LC
  LD
  M
}

enum EyeShape {
  ALMOND
  ROUND
  HOODED
  DOWNTURNED
  UPTURNED
  DEEP_SET
  PROTRUDING
  MONOLID
}

enum FaceShape {
  OVAL
  ROUND
  SQUARE
  HEART
  DIAMOND
  OBLONG
}

enum EyeSpacing {
  CLOSE_SET
  AVERAGE
  WIDE_SET
}

enum EyeTilt {
  UPTURNED
  NEUTRAL
  DOWNTURNED
}

enum Scale3 {
  LOW
  MEDIUM
  HIGH
}

/// O que a cliente quer alcançar. É o que orienta a escolha do mapping.
enum VisagismGoal {
  OPEN_EYE
  ELONGATE
  LIFT_OUTER
  CORRECT_DOWNTURNED
  CORRECT_CLOSE_SET
  CORRECT_WIDE_SET
  SENSUAL
  NATURAL
  GLAMOROUS
}

/// Análise natural e visagismo. Uma por cliente, atualizada quando muda.
model LashProfile {
  id       String @id @default(cuid())
  clientId String @unique

  // ── Análise Natural ──
  eyeColor                String?
  eyeShape                EyeShape?
  eyeSpacing              EyeSpacing?
  eyeSize                 Scale3?
  eyeTilt                 EyeTilt?
  faceShape               FaceShape?
  skinTone                String?
  naturalColor            String?
  /// Espessura em mícrones: 0,15 mm = 150. Inteiro para não haver 0,1499999.
  naturalThicknessMicrons Int?
  naturalDensity          Scale3?
  naturalLengthMm         Int?
  naturalCurl             LashCurl?
  growthDirection         String?
  lashStrength            Scale3?
  eyeSensitivity          Scale3?
  wearsGlasses            Boolean     @default(false)

  // ── Visagismo ──
  goals         VisagismGoal[] @default([])
  visagismNotes String?
  /// Efeitos que a cliente gostaria de experimentar um dia.
  wishlist      String[]       @default([])

  lastReviewedAt   DateTime? @db.Timestamptz(3)
  lastReviewedById String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Um mapping por aplicação. É o registo técnico do que foi feito.
model Mapping {
  id            String  @id @default(cuid())
  unitId        String
  clientId      String
  /// A que atendimento pertence. Nulo se registado fora da agenda.
  appointmentId String? @unique

  name String

  curl             LashCurl?
  thicknessMicrons Int?
  fanType          String?
  fansPerEye       Int?
  glueBrand        String?
  lashBrand        String?
  removerBrand     String?
  primerBrand      String?
  otherProducts    String?
  applicationMin   Int?

  /// Retenção avaliada na visita seguinte, de 1 a 5. Nulo enquanto não se sabe
  /// — e é essa a informação que diz se o mapping resultou.
  retentionStars Int?
  retentionNote  String?

  recommendedProducts String?
  notes               String?

  /// Fotografia do mapping desenhado à mão, quando existe.
  sketchPath String?

  appliedAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  unit        Unit          @relation(fields: [unitId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  zones       MappingZone[]

  @@index([clientId, appliedAt])
  @@index([unitId, appliedAt])
}

/// Uma zona do olho, do canto interno ao externo.
///
/// É isto que o diagrama interativo desenha: cada zona guarda o comprimento
/// aplicado, e opcionalmente curvatura e espessura próprias — porque há
/// mappings que mudam a curvatura só no canto externo.
model MappingZone {
  id        String @id @default(cuid())
  mappingId String

  /// LEFT ou RIGHT. Os dois olhos raramente são simétricos.
  eye      String
  /// 1 = canto interno. Cresce até ao canto externo.
  position Int

  lengthMm         Int
  curl             LashCurl?
  thicknessMicrons Int?

  mapping Mapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, eye, position])
  @@index([mappingId])
}

// ═══════════════════════════════════════════════════════════
// PORTAL DE CLIENTE E LOJA
// ═══════════════════════════════════════════════════════════
//
// Suporta o login self-service (site + CRM unificados) e a loja online.
// Cupões, recompensas e cartões-oferta reaproveitam os modelos que já
// existiam (Coupon, Reward, GiftCard) — nada disso é duplicado aqui.

/// Login de cliente. Separado do Client (ficha rica gerida pela equipa)
/// de propósito: nem toda cliente tem conta online, e misturar os dois
/// tornaria o Client obrigatoriamente "uma conta", quando hoje é só um
/// registo de negócio.
model ClientAccount {
  id           String    @id @default(cuid())
  clientId     String    @unique
  email        String    @unique
  /// Opcional: quem entra só por Google não tem password própria aqui.
  passwordHash String?
  googleId     String?   @unique
  /// `null` = conta pendente de aprovação da equipa. Só fica preenchido
  /// quando a conta se liga a uma ficha de cliente já conhecida (mesmo
  /// telefone já na base) ou quando a equipa aprova manualmente — evita que
  /// qualquer pessoa se registe e tenha acesso imediato a marcações.
  approvedAt   DateTime? @db.Timestamptz(3)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions ClientSession[]
}

/// Sessão do portal de cliente. Espelha o Session da equipa (token opaco,
/// hash SHA-256, nunca em claro na base) mas fica numa tabela à parte —
/// os dois domínios de confiança não se tocam em lado nenhum do sistema.
model ClientSession {
  id              String   @id @default(cuid())
  sessionToken    String   @unique
  clientAccountId String
  expires         DateTime @db.Timestamptz(3)
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([clientAccountId])
  @@index([expires])
}

model Product {
  id          String   @id @default(cuid())
  unitId      String
  slug        String
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  category    String?
  stockQty    Int      @default(0)
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  unit  Unit        @relation(fields: [unitId], references: [id])
  items OrderItem[]

  @@unique([unitId, slug])
}

model Order {
  id              String   @id @default(cuid())
  unitId          String
  clientId        String
  code            String   @unique
  status          String   @default("PENDING")
  subtotalCents   Int
  discountCents   Int      @default(0)
  totalCents      Int
  couponId        String?
  shippingAddress String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  unit     Unit        @relation(fields: [unitId], references: [id])
  client   Client      @relation(fields: [clientId], references: [id])
  coupon   Coupon?     @relation(fields: [couponId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([unitId, createdAt])
  @@index([clientId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
